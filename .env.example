# Copy this file to `.env` and fill in the value. `.env` is git-ignored.
#
# Google Gemini API key used by the receipt scanner.
# NOTE: Vite inlines VITE_* variables into the client bundle, so this key is visible
# to anyone who loads the site. Restrict it by HTTP referrer and set a quota in Google AI Studio.
VITE_GEMINI_API_KEY=
